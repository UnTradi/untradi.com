---
import { PODCAST_LINKS, SITE_TITLE } from '../consts';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<div class="footer-top">
			<div class="footer-brand">
				<p class="footer-title">{SITE_TITLE}</p>
				<p class="footer-tagline">Reflexiones sobre el tradicionalismo católico y la liturgia</p>
			</div>

			<div class="footer-col">
				<p class="footer-col-label">Síguenos</p>
				<SocialLinks size={18} />
			</div>

			<div class="footer-col">
				<p class="footer-col-label">Podcast</p>
				<ul class="podcast-list">
					{PODCAST_LINKS.map(({ label, href }) => (
						<li>
							<a href={href} target="_blank" rel="noopener noreferrer">{label}</a>
						</li>
					))}
				</ul>
			</div>
		</div>

		<div class="footer-bottom">
			<nav class="footer-nav" aria-label="Pie de página">
				<a href="/">Inicio</a>
				<span aria-hidden="true">·</span>
				<a href="/faq/">FAQ</a>
				<span aria-hidden="true">·</span>
				<a href="/contacto-roma/">Contacta a Roma</a>
				<span aria-hidden="true">·</span>
				<a href="/rss.xml">RSS</a>
			</nav>
			<p class="footer-copy">&copy; {year} {SITE_TITLE}</p>
		</div>
	</div>
</footer>

<style>
	footer {
		background: var(--bg-surface);
		border-top: 1px solid var(--border);
		padding: 3rem 2rem 2rem;
		margin-top: 0;
	}

	.footer-inner {
		max-width: var(--max-wide);
		margin: 0 auto;
	}

	.footer-top {
		display: grid;
		grid-template-columns: 1fr auto auto;
		gap: 3rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--border);
		align-items: start;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.footer-title {
		font-family: var(--font-display);
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--text);
		margin: 0;
	}

	.footer-tagline {
		font-family: var(--font-body);
		font-size: 0.85rem;
		font-style: italic;
		color: var(--text-muted);
		margin: 0;
	}

	.footer-col-label {
		font-family: var(--font-ui);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--text-faint);
		margin: 0 0 0.85rem;
	}

	.podcast-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.podcast-list a {
		font-family: var(--font-ui);
		font-size: 0.82rem;
		color: var(--text-muted);
	}

	.podcast-list a:hover {
		color: var(--red);
		text-decoration: none;
	}

	.footer-bottom {
		padding-top: 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.footer-nav {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.footer-nav a {
		font-family: var(--font-ui);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.footer-nav a:hover {
		color: var(--red);
		text-decoration: none;
	}

	.footer-nav span {
		color: var(--text-faint);
		font-size: 0.6rem;
	}

	.footer-copy {
		font-family: var(--font-ui);
		font-size: 0.72rem;
		color: var(--text-faint);
		margin: 0;
	}

	@media (max-width: 820px) {
		.footer-top {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 480px) {
		.footer-top {
			grid-template-columns: 1fr;
		}
		footer {
			padding: 2.5rem 1.25rem 1.5rem;
		}
	}
</style>
