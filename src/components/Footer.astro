---
import { PODCAST_LINKS, SITE_TITLE } from '../consts';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<div class="colophon" aria-hidden="true">
	<span class="colophon-line"></span>
	<span class="colophon-cross">✠</span>
	<span class="colophon-line"></span>
</div>

<footer>
	<div class="footer-inner">
		<div class="footer-brand-banner">
			<div class="footer-cross" aria-hidden="true">✠</div>
			<p class="footer-title">{SITE_TITLE}</p>
			<p class="footer-tagline">Reflexiones sobre el tradicionalismo católico y la liturgia</p>
		</div>

		<div class="footer-top">
			<div class="footer-col">
				<p class="footer-col-label">Síguenos</p>
				<SocialLinks size={18} />
			</div>

			<div class="footer-col">
				<p class="footer-col-label">Podcast</p>
				<ul class="podcast-list">
					{PODCAST_LINKS.map(({ label, href }) => (
						<li>
							<a href={href} target="_blank" rel="noopener noreferrer" class="podcast-link">
								<span class="podcast-link-dot" aria-hidden="true"></span>
								{label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div class="footer-col">
				<p class="footer-col-label">Navegar</p>
				<ul class="nav-list">
					<li><a href="/" class="podcast-link"><span class="podcast-link-dot" aria-hidden="true"></span>Inicio</a></li>
					<li><a href="/manifiesto/" class="podcast-link"><span class="podcast-link-dot" aria-hidden="true"></span>Manifiesto</a></li>
					<li><a href="/faq/" class="podcast-link"><span class="podcast-link-dot" aria-hidden="true"></span>FAQ</a></li>
					<li><a href="/contacto-roma/" class="podcast-link"><span class="podcast-link-dot" aria-hidden="true"></span>Contacta a Roma</a></li>
					<li><a href="/rss.xml" class="podcast-link"><span class="podcast-link-dot" aria-hidden="true"></span>RSS</a></li>
				</ul>
			</div>
		</div>

		<div class="footer-bottom">
			<div class="footer-bottom-ornament" aria-hidden="true">
				<span class="footer-ornament-line"></span>
				<span class="footer-ornament-cross">✦</span>
				<span class="footer-ornament-line"></span>
			</div>
			<p class="footer-copy">&copy; {year} {SITE_TITLE} · Todos los derechos reservados</p>
		</div>
	</div>
</footer>

<style>
	/* ── Colofón: transición papel → tapa ──── */

	.colophon {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		padding: 1.75rem 2rem;
		max-width: 480px;
		margin: 0 auto;
	}

	.colophon-line {
		flex: 1;
		height: 1px;
		background: linear-gradient(to right, transparent, var(--gold));
		opacity: 0.55;
	}

	.colophon-line:last-child {
		background: linear-gradient(to left, transparent, var(--gold));
	}

	.colophon-cross {
		font-size: 1.1rem;
		color: var(--gold);
		opacity: 0.75;
		line-height: 1;
	}

	footer {
		background: var(--red-dark);
		border-top: 2px solid var(--gold);
		padding: 0 2rem 2rem;
		--footer-cream: var(--gold-pale);
		--footer-line: color-mix(in srgb, var(--gold-pale) 18%, transparent);
	}

	.footer-inner {
		max-width: var(--max-wide);
		margin: 0 auto;
	}

	/* ── Brand banner ─────────────────────── */

	.footer-brand-banner {
		text-align: center;
		padding: 3rem 0 2.5rem;
		border-bottom: 1px solid var(--footer-line);
	}

	.footer-cross {
		font-size: 1.5rem;
		color: var(--gold-light);
		opacity: 0.8;
		margin-bottom: 0.75rem;
		display: block;
	}

	.footer-title {
		font-family: var(--font-display);
		font-size: 1.45rem;
		font-weight: 700;
		color: var(--footer-cream);
		margin: 0 0 0.4rem;
	}

	.footer-tagline {
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-style: italic;
		color: color-mix(in srgb, var(--footer-cream) 70%, transparent);
		margin: 0;
	}

	/* ── Top cols ─────────────────────────── */

	.footer-top {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 3rem;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--footer-line);
		align-items: start;
	}

	.footer-col :global(.social-link) {
		color: color-mix(in srgb, var(--footer-cream) 75%, transparent);
	}

	.footer-col :global(.social-link:hover) {
		color: #FFFFFF;
	}

	.footer-col-label {
		font-family: var(--font-ui);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--gold-light);
		margin: 0 0 1rem;
	}

	.podcast-list,
	.nav-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.podcast-link {
		font-family: var(--font-ui);
		font-size: 0.82rem;
		color: color-mix(in srgb, var(--footer-cream) 80%, transparent);
		display: flex;
		align-items: center;
		gap: 0.5em;
		transition: color 0.2s;
		text-decoration: none;
	}

	.podcast-link-dot {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--gold-light) 60%, transparent);
		flex-shrink: 0;
		transition: background 0.2s;
	}

	.podcast-link:hover {
		color: #FFFFFF;
		text-decoration: none;
	}

	.podcast-link:hover .podcast-link-dot {
		background: var(--gold-light);
	}

	/* ── Bottom ───────────────────────────── */

	.footer-bottom {
		padding-top: 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.footer-bottom-ornament {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		max-width: 300px;
	}

	.footer-ornament-line {
		flex: 1;
		height: 1px;
		background: linear-gradient(to right, transparent, var(--footer-line));
	}

	.footer-ornament-line:last-child {
		background: linear-gradient(to left, transparent, var(--footer-line));
	}

	.footer-ornament-cross {
		font-size: 0.5rem;
		color: var(--gold-light);
		opacity: 0.8;
	}

	.footer-copy {
		font-family: var(--font-ui);
		font-size: 0.7rem;
		color: color-mix(in srgb, var(--footer-cream) 55%, transparent);
		margin: 0;
		text-align: center;
	}

	/* ── Responsive ─────────────────────── */

	@media (max-width: 820px) {
		.footer-top {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
	}

	@media (max-width: 480px) {
		.footer-top {
			grid-template-columns: 1fr;
		}
		footer {
			padding: 0 1.25rem 1.5rem;
		}
	}
</style>
