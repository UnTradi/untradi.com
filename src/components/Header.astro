---
import { SITE_TITLE } from '../consts';
import SocialLinks from './SocialLinks.astro';
---

<header id="site-header">
	<div class="header-band">
		<div class="header-band-inner">
			<span class="header-tagline">
				<span class="header-tagline-ornament" aria-hidden="true">✦</span>
				Tradición · Liturgia · Fe
				<span class="header-tagline-ornament" aria-hidden="true">✦</span>
			</span>
			<a href="/rss.xml" class="header-rss">RSS</a>
		</div>
	</div>
	<div class="header-main">
		<div class="header-main-inner">
			<div aria-hidden="true"></div>
			<a href="/" class="masthead" aria-label="Inicio">
				<span class="masthead-ornament" aria-hidden="true">✠</span>
				<span class="masthead-title" transition:name="site-masthead">{SITE_TITLE}</span>
				<span class="masthead-ornament" aria-hidden="true">✠</span>
			</a>
			<div class="header-social">
				<SocialLinks size={17} />
			</div>
		</div>
	</div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--border);
		transition: box-shadow 0.3s ease;
	}

	header::before {
		content: '';
		display: block;
		height: 4px;
		background: linear-gradient(
			90deg,
			var(--red-dark) 0%,
			var(--red) 25%,
			var(--gold) 50%,
			var(--red) 75%,
			var(--red-dark) 100%
		);
		background-size: 300% 100%;
		animation: gradientShift 8s ease infinite;
		box-shadow: 0 1px 8px color-mix(in srgb, var(--red) 35%, transparent);
	}

	header.is-scrolled {
		box-shadow:
			0 2px 0 color-mix(in srgb, var(--gold) 8%, transparent),
			0 4px 24px color-mix(in srgb, var(--text) 14%, transparent);
	}

	/* ── Banda superior ─────────────────────── */

	.header-band {
		background: linear-gradient(
			to right,
			var(--bg-elevated),
			color-mix(in srgb, var(--gold-pale) 30%, var(--bg-elevated)),
			var(--bg-elevated)
		);
		border-bottom: 1px solid var(--border-light);
	}

	.header-band-inner {
		max-width: var(--max-wide);
		margin: 0 auto;
		padding: 0 2rem;
		height: 28px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.header-tagline {
		font-family: var(--font-ui);
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--text-faint);
		display: flex;
		align-items: center;
		gap: 0.6em;
	}

	.header-tagline-ornament {
		color: var(--gold);
		font-size: 0.5rem;
		opacity: 0.7;
		animation: spinSlow 20s linear infinite;
		display: inline-block;
	}

	.header-rss {
		font-family: var(--font-ui);
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-faint);
		text-decoration: none;
		transition: color 0.2s;
		padding: 0.2em 0.5em;
		border: 1px solid transparent;
		border-radius: 2px;
		transition: color 0.2s, border-color 0.2s;
	}

	.header-rss:hover {
		color: var(--red);
		border-color: color-mix(in srgb, var(--red) 30%, transparent);
		text-decoration: none;
	}

	/* ── Masthead principal ─────────────────── */

	.header-main {
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--gold-pale) 20%, var(--bg-surface)) 0%,
			var(--bg-surface) 100%
		);
	}

	.header-main-inner {
		max-width: var(--max-wide);
		margin: 0 auto;
		padding: 0 2rem;
		height: 80px;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}

	.masthead {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 0.7em;
		text-decoration: none;
		justify-self: center;
		position: relative;
	}

	.masthead-ornament {
		font-size: 0.8rem;
		color: var(--gold);
		opacity: 0.6;
		transition: opacity 0.3s, transform 0.3s;
		line-height: 1;
	}

	.masthead:hover .masthead-ornament {
		opacity: 1;
		transform: scale(1.2);
	}

	.masthead-title {
		font-family: var(--font-display);
		font-size: 1.55rem;
		font-weight: 700;
		color: var(--text);
		letter-spacing: -0.015em;
		white-space: nowrap;
		line-height: 1;
		transition: color 0.2s;
		position: relative;
	}

	.masthead-title::after {
		content: '';
		position: absolute;
		bottom: -3px;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--red), transparent);
		transform: scaleX(0);
		transition: transform 0.4s var(--ease-out-expo);
	}

	.masthead:hover .masthead-title {
		color: var(--red);
	}

	.masthead:hover .masthead-title::after {
		transform: scaleX(1);
	}

	.header-social {
		display: flex;
		justify-content: flex-end;
		align-items: center;
	}

	/* ── Mobile ─────────────────────────────── */

	@media (max-width: 640px) {
		.header-band { display: none; }

		.header-main-inner {
			grid-template-columns: 1fr;
			padding: 0 1.25rem;
		}

		.masthead { justify-self: start; }

		.masthead-ornament { display: none; }
		.masthead-title { font-size: 1.1rem; }

		.header-social { display: none; }
	}
</style>

<script>
	function initHeader() {
		const header = document.getElementById('site-header');
		if (!header) return;

		const updateHeader = () => {
			header.classList.toggle('is-scrolled', window.scrollY > 20);
		};

		window.addEventListener('scroll', updateHeader, { passive: true });
		updateHeader();
	}

	document.addEventListener('astro:page-load', initHeader);
</script>
