---
import { SITE_TITLE } from '../consts';
import SocialLinks from './SocialLinks.astro';
---

<header id="site-header">
	<div class="header-band">
		<div class="header-band-inner">
			<span class="header-tagline">
				<span class="header-tagline-ornament" aria-hidden="true">✦</span>
				Tradición · Liturgia · Fe
				<span class="header-tagline-ornament" aria-hidden="true">✦</span>
			</span>
			<a href="/rss.xml" class="header-rss">RSS</a>
		</div>
	</div>
	<div class="header-main">
		<div class="header-main-inner">
			<a href="/" class="masthead" aria-label="Inicio">
				<span class="masthead-ornament" aria-hidden="true">✠</span>
				<span class="masthead-title" transition:name="site-masthead">{SITE_TITLE}</span>
				<span class="masthead-ornament" aria-hidden="true">✠</span>
			</a>
			<div class="header-social">
				<SocialLinks size={17} />
			</div>
		</div>
	</div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 2px solid var(--gold);
		transition: box-shadow 0.3s ease;
	}

	header.is-scrolled {
		box-shadow: 0 2px 16px color-mix(in srgb, var(--red-dark) 35%, transparent);
	}

	/* ── Banda superior: listón verde ───────── */

	.header-band {
		background: var(--green-dark);
		border-bottom: 1px solid color-mix(in srgb, var(--gold) 35%, transparent);
	}

	.header-band-inner {
		max-width: var(--max-wide);
		margin: 0 auto;
		padding: 0 2rem;
		height: 28px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.header-tagline {
		font-family: var(--font-ui);
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gold-pale);
		display: flex;
		align-items: center;
		gap: 0.6em;
	}

	.header-tagline-ornament {
		color: var(--gold-light);
		font-size: 0.5rem;
	}

	.header-rss {
		font-family: var(--font-ui);
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--gold-pale);
		text-decoration: none;
		padding: 0.2em 0.5em;
		border: 1px solid transparent;
		border-radius: 2px;
		transition: color 0.2s, border-color 0.2s;
	}

	.header-rss:hover {
		color: #FFFFFF;
		border-color: color-mix(in srgb, var(--gold-pale) 50%, transparent);
		text-decoration: none;
	}

	/* ── Masthead principal ─────────────────── */

	/* ── Masthead: tapa de misal ────────────── */

	.header-main {
		background: var(--red-dark);
	}

	.header-main-inner {
		max-width: var(--max-wide);
		margin: 0 auto;
		padding: 0 2rem;
		height: 104px;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.masthead {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 0.7em;
		text-decoration: none;
		position: relative;
	}

	.masthead-ornament {
		font-size: 1rem;
		color: var(--gold-light);
		opacity: 0.8;
		transition: opacity 0.3s;
		line-height: 1;
	}

	.masthead:hover .masthead-ornament {
		opacity: 1;
	}

	.masthead-title {
		font-family: var(--font-display);
		font-size: 2.3rem;
		font-weight: 700;
		color: var(--gold-pale);
		letter-spacing: -0.015em;
		white-space: nowrap;
		line-height: 1;
		transition: color 0.2s;
		position: relative;
	}

	.masthead-title::after {
		content: '';
		position: absolute;
		bottom: -3px;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--gold-light), transparent);
		transform: scaleX(0);
		transition: transform 0.4s var(--ease-out-expo);
	}

	.masthead:hover .masthead-title {
		color: #FFFFFF;
	}

	.masthead:hover .masthead-title::after {
		transform: scaleX(1);
	}

	.header-social {
		position: absolute;
		right: 2rem;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		align-items: center;
	}

	/* Evita que los iconos pisen el título centrado */
	@media (max-width: 980px) {
		.header-social { display: none; }
	}

	.header-social :global(.social-link) {
		color: color-mix(in srgb, var(--gold-pale) 80%, transparent);
	}

	.header-social :global(.social-link:hover) {
		color: #FFFFFF;
	}

	/* ── Mobile ─────────────────────────────── */

	@media (max-width: 640px) {
		.header-band-inner { padding: 0 1.25rem; }

		.header-main-inner {
			justify-content: flex-start;
			padding: 0 1.25rem;
			height: 76px;
		}

		.masthead-ornament { display: none; }
		.masthead-title { font-size: 1.5rem; }
	}
</style>

<script>
	function initHeader() {
		const header = document.getElementById('site-header');
		if (!header) return;

		const updateHeader = () => {
			header.classList.toggle('is-scrolled', window.scrollY > 20);
		};

		window.addEventListener('scroll', updateHeader, { passive: true });
		updateHeader();
	}

	document.addEventListener('astro:page-load', initHeader);
</script>
