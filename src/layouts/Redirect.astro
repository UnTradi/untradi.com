---
import { SITE_TITLE } from '../consts';

interface Props {
	destination: string;
	label: string;
	category?: string;
}

const { destination, label, category = 'Enlace externo' } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Redirigiendo a {label} — {SITE_TITLE}</title>

		<!--
			El script se ejecuta de forma sincrónica antes de que el navegador
			pinte cualquier pixel del body. En el 99 % de los casos el usuario
			nunca ve esta página.
		-->
		<script is:inline define:vars={{ destination }}>
			location.replace(destination);
		</script>
		<meta http-equiv="refresh" content={`0; url=${destination}`} />
		<link rel="canonical" href={destination} />

		<!-- Fuentes y estilos solo en caso de que el usuario llegue a ver la página -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,500&family=Lato:wght@400;700&display=swap"
			rel="stylesheet"
		/>

		<style>
			:root {
				color-scheme: light;
				--bg: #FBF6EB;
				--bg-surface: #F4ECDB;
				--bg-elevated: #ECE0C8;
				--text: #271C10;
				--text-muted: #5D4A36;
				--text-faint: #8F7657;
				--red: #9E2B25;
				--gold: #B08A2E;
				--gold-pale: #F2E5C4;
				--border: #D9C9AB;
				--font-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
				--font-ui: 'Lato', 'Helvetica Neue', Helvetica, Arial, sans-serif;
			}

			*, *::before, *::after { box-sizing: border-box; }

			html { scroll-behavior: smooth; }

			body {
				margin: 0;
				padding: 0;
				font-family: var(--font-ui);
				background-color: var(--bg);
				color: var(--text);
				min-height: 100dvh;
				display: flex;
				flex-direction: column;
				-webkit-font-smoothing: antialiased;
			}

			/* ── Header mínimo ─────────────────── */

			.site-header {
				border-top: 3px solid var(--red);
				border-bottom: 1px solid var(--border);
				background: var(--bg-surface);
			}

			.site-header-inner {
				max-width: 1100px;
				margin: 0 auto;
				padding: 0 2rem;
				height: 80px;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.site-title {
				font-family: var(--font-display);
				font-size: 1.4rem;
				font-weight: 700;
				color: var(--text);
				text-decoration: none;
				letter-spacing: -0.015em;
			}

			.site-title:hover { color: var(--red); }

			/* ── Contenido central ─────────────── */

			.redirect-main {
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 4rem 2rem;
			}

			.redirect-wrap {
				text-align: center;
				max-width: 480px;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
			}

			.redirect-category {
				font-family: var(--font-ui);
				font-size: 0.62rem;
				font-weight: 700;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--gold);
				margin: 0;
			}

			.redirect-cross {
				font-size: 2rem;
				color: var(--gold);
				opacity: 0.5;
				line-height: 1;
				animation: breathe 2.5s ease-in-out infinite;
			}

			@keyframes breathe {
				0%, 100% { opacity: 0.35; transform: scale(1); }
				50%       { opacity: 0.7;  transform: scale(1.08); }
			}

			.redirect-heading {
				font-family: var(--font-display);
				font-size: clamp(1.6rem, 4vw, 2.4rem);
				font-weight: 700;
				color: var(--text);
				margin: 0;
				letter-spacing: -0.02em;
				line-height: 1.2;
			}

			.redirect-label {
				font-family: var(--font-ui);
				font-size: 0.85rem;
				color: var(--text-muted);
				margin: 0;
				letter-spacing: 0.04em;
			}

			.redirect-dots {
				display: flex;
				gap: 0.5rem;
				align-items: center;
				margin: 0.5rem 0;
			}

			.redirect-dots span {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--gold);
				opacity: 0.4;
				animation: dotPulse 1.4s ease-in-out infinite;
			}

			.redirect-dots span:nth-child(2) { animation-delay: 0.2s; }
			.redirect-dots span:nth-child(3) { animation-delay: 0.4s; }

			@keyframes dotPulse {
				0%, 80%, 100% { opacity: 0.2; transform: scale(0.85); }
				40%           { opacity: 1;   transform: scale(1.15); }
			}

			.redirect-link {
				font-family: var(--font-ui);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--red);
				text-decoration: none;
				padding: 0.6em 1.2em;
				border: 1px solid color-mix(in srgb, var(--red) 40%, var(--border));
				transition: background 0.2s, color 0.2s, border-color 0.2s;
				margin-top: 0.5rem;
			}

			.redirect-link:hover {
				background: var(--red);
				color: var(--bg);
				border-color: var(--red);
			}

			.redirect-divider {
				width: 40px;
				height: 1px;
				background: linear-gradient(to right, transparent, var(--gold), transparent);
				margin: 0.25rem 0;
			}

			/* ── Footer mínimo ─────────────────── */

			.site-footer {
				border-top: 1px solid var(--border);
				background: var(--bg-surface);
				padding: 1.25rem 2rem;
				text-align: center;
			}

			.site-footer-text {
				font-family: var(--font-ui);
				font-size: 0.7rem;
				color: var(--text-faint);
				margin: 0;
			}

			@media (max-width: 640px) {
				.site-header-inner { padding: 0 1.25rem; }
				.redirect-main { padding: 3rem 1.25rem; }
			}
		</style>
	</head>

	<body>
		<header class="site-header">
			<div class="site-header-inner">
				<a href="/" class="site-title">Un Tradi en el Novus Ordo</a>
			</div>
		</header>

		<main class="redirect-main">
			<div class="redirect-wrap">
				<p class="redirect-category">{category}</p>
				<div class="redirect-cross" aria-hidden="true">✠</div>
				<div class="redirect-divider" aria-hidden="true"></div>
				<h1 class="redirect-heading">Redirigiendo&hellip;</h1>
				<p class="redirect-label">{label}</p>
				<div class="redirect-dots" aria-label="Cargando">
					<span></span><span></span><span></span>
				</div>
				<a href={destination} class="redirect-link">
					Ir directamente &rarr;
				</a>
			</div>
		</main>

		<footer class="site-footer">
			<p class="site-footer-text">&copy; {new Date().getFullYear()} {SITE_TITLE}</p>
		</footer>
	</body>
</html>
