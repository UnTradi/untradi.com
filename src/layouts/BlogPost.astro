---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;

const url = Astro.url.pathname;
const slug = url.replace(/^\/blog\//, '').replace(/\/$/, '');
const canonicalURL = new URL(url, Astro.site).href;
const ogImage = new URL(`/og/${slug}.png`, Astro.site).href;

const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	url: canonicalURL,
	image: ogImage,
	author: {
		'@type': 'Person',
		name: 'Un Tradi en el Novus Ordo',
		url: 'https://untradi.com',
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: 'https://untradi.com',
	},
};
---

<html lang="es">
	<head>
		<BaseHead
			title={`${title} — ${SITE_TITLE}`}
			description={description}
			image={`/og/${slug}.png`}
			ogType="article"
			pubDate={pubDate}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
		<style>
			.reading-progress {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 2px;
				background: var(--red);
				transform-origin: left center;
				transform: scaleX(0);
				z-index: 200;
			}

			@supports (animation-timeline: scroll()) {
				.reading-progress {
					animation: reading-progress linear;
					animation-timeline: scroll();
					animation-range: 0 100%;
				}

				@keyframes reading-progress {
					from { transform: scaleX(0); }
					to { transform: scaleX(1); }
				}
			}

			.article-wrap {
				max-width: var(--max-wide);
				margin: 0 auto;
				padding: 0 2rem;
			}

			.article-header {
				max-width: var(--max-prose);
				margin: 4.5rem auto 3.5rem;
				text-align: center;
			}

			.article-title {
				font-family: var(--font-display);
				font-size: clamp(2rem, 5vw, 3.2rem);
				font-weight: 700;
				color: var(--text);
				line-height: 1.15;
				margin: 0 0 1.25rem;
				letter-spacing: -0.02em;
			}

			.article-description {
				font-family: var(--font-body);
				font-size: 1.15rem;
				font-style: italic;
				color: var(--text-muted);
				margin: 0 0 1.5rem;
				line-height: 1.65;
			}

			.article-meta {
				font-family: var(--font-ui);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text-faint);
			}

			.article-rule {
				width: 40px;
				height: 2px;
				background: var(--red);
				border: none;
				margin: 2.5rem auto;
			}

			.prose {
				max-width: var(--max-prose);
				margin: 0 auto;
				padding-bottom: 5rem;
			}

			.prose a {
				color: var(--red);
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 3px;
				text-decoration-color: color-mix(in srgb, var(--red) 40%, transparent);
				transition: color 0.15s, text-decoration-color 0.15s;
			}

			.prose a:hover {
				color: var(--red-light);
				text-decoration-color: var(--red-light);
			}

			.article-footer {
				max-width: var(--max-prose);
				margin: 0 auto 4rem;
				padding-top: 2rem;
				border-top: 1px solid var(--border);
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 1rem;
			}

			.back-link {
				font-family: var(--font-ui);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--text-muted);
				display: flex;
				align-items: center;
				gap: 0.5em;
				transition: color 0.15s;
			}

			.back-link::before {
				content: '←';
				font-family: var(--font-body);
				font-size: 1rem;
				font-weight: 400;
				letter-spacing: 0;
			}

			.back-link:hover {
				color: var(--red);
				text-decoration: none;
			}

			.updated-note {
				font-family: var(--font-ui);
				font-size: 0.72rem;
				color: var(--text-faint);
				font-style: italic;
			}

			@media (max-width: 640px) {
				.article-wrap {
					padding: 0 1.25rem;
				}
				.article-header {
					margin-top: 3rem;
				}
			}
		</style>
	</head>

	<body>
		<div class="reading-progress" aria-hidden="true"></div>
		<Header />
		<main>
			<div class="article-wrap">
				<header class="article-header">
					<h1 class="article-title">{title}</h1>
					{description && (
						<p class="article-description">{description}</p>
					)}
					<div class="article-meta">
						<FormattedDate date={pubDate} />
					</div>
					<hr class="article-rule" />
				</header>

				<article class="prose">
					<slot />
				</article>

				<footer class="article-footer">
					<a href="/" class="back-link">Volver al inicio</a>
					{updatedDate && (
						<span class="updated-note">
							Actualizado el <FormattedDate date={updatedDate} />
						</span>
					)}
				</footer>
			</div>
		</main>
		<Footer />
	</body>
</html>
