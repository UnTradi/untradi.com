---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { CATEGORIES, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const categories = [...new Set(allPosts.map((p) => p.data.category).filter(Boolean))];
	return categories.map((cat) => ({
		params: { categoria: cat },
		props: {
			posts: allPosts
				.filter((p) => p.data.category === cat)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { categoria } = Astro.params;
const { posts } = Astro.props;
const categoryLabel = CATEGORIES[categoria!] ?? categoria;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const collectionJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `${categoryLabel} — ${SITE_TITLE}`,
	description: `Artículos sobre ${categoryLabel} en el blog Un Tradi en el Novus Ordo.`,
	url: canonicalURL,
	inLanguage: 'es-MX',
	hasPart: posts.map((post) => ({
		'@type': 'BlogPosting',
		headline: post.data.title,
		url: new URL(`/blog/${post.id}/`, Astro.site).href,
		datePublished: post.data.pubDate.toISOString(),
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`${categoryLabel} — ${SITE_TITLE}`}
			description={`Artículos sobre ${categoryLabel} en el blog Un Tradi en el Novus Ordo.`}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
		<style>
			.page-header {
				background: var(--bg-surface);
				border-bottom: 1px solid var(--border);
				padding: 3rem 2rem 2.5rem;
			}

			.page-header-inner {
				max-width: var(--max-wide);
				margin: 0 auto;
			}

			.page-eyebrow {
				font-family: var(--font-ui);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: var(--text-faint);
				margin: 0 0 0.75rem;
			}

			.page-eyebrow a {
				color: var(--text-faint);
			}

			.page-eyebrow a:hover {
				color: var(--red);
				text-decoration: none;
			}

			.page-title {
				font-family: var(--font-display);
				font-size: clamp(2rem, 5vw, 3rem);
				font-weight: 700;
				color: var(--text);
				margin: 0 0 0.5rem;
			}

			.page-count {
				font-family: var(--font-ui);
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--text-faint);
				margin: 0;
			}

			main {
				max-width: var(--max-wide);
				margin: 0 auto;
				padding: 3rem 2rem 5rem;
			}

			.posts-list {
				display: flex;
				flex-direction: column;
			}

			.post-row {
				display: grid;
				grid-template-columns: 140px 1fr;
				gap: 2.5rem;
				padding: 1.5rem 0;
				border-bottom: 1px solid var(--border);
				text-decoration: none;
				align-items: baseline;
				transition: box-shadow 0.2s;
			}

			.post-row:first-child {
				border-top: 1px solid var(--border);
			}

			.post-row:hover {
				text-decoration: none;
				box-shadow: -2px 0 0 var(--red);
			}

			.post-row-date {
				font-family: var(--font-ui);
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--text-faint);
				white-space: nowrap;
				padding-top: 0.2rem;
			}

			.post-row-title {
				font-family: var(--font-display);
				font-size: 1.2rem;
				font-weight: 700;
				color: var(--text);
				margin: 0 0 0.3rem;
				line-height: 1.25;
				letter-spacing: -0.01em;
				transition: color 0.2s;
			}

			.post-row:hover .post-row-title {
				color: var(--red);
			}

			.post-row-desc {
				font-family: var(--font-body);
				font-size: 0.9rem;
				font-style: italic;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.5;
			}

			.empty-state {
				text-align: center;
				padding: 4rem;
				color: var(--text-muted);
			}

			@media (max-width: 640px) {
				.post-row {
					grid-template-columns: 1fr;
					gap: 0.5rem;
				}

				main {
					padding: 2rem 1.25rem 3rem;
				}

				.page-header {
					padding: 2rem 1.25rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<div class="page-header">
			<div class="page-header-inner">
				<p class="page-eyebrow">
					<a href="/">Inicio</a> / Categoría
				</p>
				<h1 class="page-title">{categoryLabel}</h1>
				<p class="page-count">
					{posts.length}
					{posts.length === 1 ? 'artículo' : 'artículos'}
				</p>
			</div>
		</div>

		<main>
			{
				posts.length === 0 ? (
					<div class="empty-state">
						<p>No hay artículos en esta categoría todavía.</p>
					</div>
				) : (
					<div class="posts-list">
						{posts.map((post) => (
							<a href={`/blog/${post.id}/`} class="post-row">
								<span class="post-row-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<div>
									<h2 class="post-row-title">{post.data.title}</h2>
									<p class="post-row-desc">{post.data.description}</p>
								</div>
							</a>
						))}
					</div>
				)
			}
		</main>

		<Footer />
	</body>
</html>
