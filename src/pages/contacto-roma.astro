	oficinas:      'Oficina',
	academias:     'Academia e Institución',
};

const catTabs = [
	{ id: 'todos',          label: 'Todos' },
	{ id: 'secretaria',     label: 'Secretaría' },
	{ id: 'congregaciones', label: 'Congregaciones' },
	{ id: 'dicasterios',    label: 'Dicasterios' },
	{ id: 'tribunales',     label: 'Tribunales' },
	{ id: 'consejos',       label: 'Consejos' },
	{ id: 'economia',       label: 'Economía' },
	{ id: 'oficinas',       label: 'Oficinas' },
	{ id: 'academias',      label: 'Academias' },
].map(tab => ({
	...tab,
	count: tab.id === 'todos'
		? organismos.length
		: organismos.filter(o => o.cat === tab.id).length,
}));

function domain(url: string): string {
	try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return url; }
}

function normalize(str: string): string {
	return str.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
}
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Contacta a Roma — ${SITE_TITLE}`}
			description="Directorio de contacto de la Curia Romana: Congregaciones, Dicasterios, Tribunales, Consejos Pontificios y más organismos de la Santa Sede."
		/>
		<style>
			.page-header {
				background: var(--bg-surface);
				border-bottom: 1px solid var(--border);
				padding: 3rem 2rem 2.5rem;
				text-align: center;
			}
			.page-title {
				font-family: var(--font-display);
				font-size: clamp(1.8rem, 5vw, 2.8rem);
				font-weight: 700;
				color: var(--text);
				margin: 0 0 0.5rem;
			}
			.page-subtitle {
				font-family: var(--font-body);
				font-size: 1rem;
				font-style: italic;
				color: var(--text-muted);
				margin: 0;
			}
			main {
				max-width: var(--max-wide);
				margin: 0 auto;
				padding: 2.5rem 2rem 5rem;
			}
			.controls {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				margin-bottom: 2rem;
			}
			.search-input {
				font-family: var(--font-body);
				font-size: 1rem;
				color: var(--text);
				background: var(--bg-elevated);
				border: 1px solid var(--border-light);
				border-radius: 3px;
				padding: 0.75rem 1rem;
				width: 100%;
				outline: none;
				-webkit-appearance: none;
				appearance: none;
				transition: border-color 0.15s, box-shadow 0.15s;
			}
			.search-input:focus {
				border-color: var(--red);
				box-shadow: 0 0 0 3px color-mix(in srgb, var(--red) 10%, transparent);
			}
			.cat-tabs {
				display: flex;
				gap: 0.4rem;
				overflow-x: auto;
				scrollbar-width: none;
				-ms-overflow-style: none;
				padding-bottom: 2px;
			}
			.cat-tabs::-webkit-scrollbar { display: none; }
			.cat-tab {
				font-family: var(--font-ui);
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--text-muted);
				background: transparent;
				border: 1px solid var(--border);
				border-radius: 2px;
				padding: 0.4em 0.85em;
				cursor: pointer;
				white-space: nowrap;
				display: flex;
				align-items: center;
				gap: 0.4em;
				transition: color 0.15s, border-color 0.15s, background 0.15s;
			}
			.cat-tab:hover {
				color: var(--text);
				border-color: var(--border-light);
				background: var(--bg-elevated);
			}
			.cat-tab.active {
				color: var(--red);
				border-color: var(--red);
				background: color-mix(in srgb, var(--red) 6%, transparent);
			}
			.tab-count {
				font-size: 0.62rem;
				color: var(--text-faint);
				background: var(--bg-elevated);
				border-radius: 2px;
				padding: 0.1em 0.4em;
			}
			.cat-tab.active .tab-count {
				background: color-mix(in srgb, var(--red) 12%, transparent);
				color: var(--red);
			}
			.cards-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
			}
			.card {
				background: var(--bg-surface);
				border: 1px solid var(--border);
				border-radius: 3px;
				display: flex;
				flex-direction: column;
				transition: border-color 0.2s;
			}
			.card:hover {
				border-color: color-mix(in srgb, var(--red) 25%, var(--border));
			}
			.card-top {
				padding: 1.1rem 1.1rem 0.75rem;
				border-bottom: 1px solid var(--border-light);
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			.badge {
				font-family: var(--font-ui);
				font-size: 0.57rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--red);
				background: color-mix(in srgb, var(--red) 8%, transparent);
				border: 1px solid color-mix(in srgb, var(--red) 18%, transparent);
				border-radius: 2px;
				padding: 0.2em 0.55em;
				align-self: flex-start;
			}
			.card-nombre {
				font-family: var(--font-display);
				font-size: 0.98rem;
				font-weight: 700;
				color: var(--text);
				margin: 0;
				line-height: 1.3;
			}
			.card-body {
				padding: 0 1.1rem;
				flex: 1;
			}
			.field {
				display: grid;
				grid-template-columns: 40px 1fr;
				gap: 0.25rem 0.5rem;
				align-items: start;
				padding: 0.55rem 0;
				border-bottom: 1px solid var(--border-light);
			}
			.field:last-child { border-bottom: none; }
			.field-label {
				font-family: var(--font-ui);
				font-size: 0.58rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text-faint);
				padding-top: 0.15rem;
			}
			.field-val {
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}
			.field-val > span, .fax-entry {
				font-family: var(--font-ui);
				font-size: 0.77rem;
				color: var(--text-muted);
				line-height: 1.4;
			}
			.postal {
				font-size: 0.7rem !important;
				color: var(--text-faint) !important;
			}
			.sub {
				font-size: 0.68rem;
				color: var(--text-faint);
				margin-left: 0.2em;
			}
			.copyrow {
				display: flex;
				align-items: center;
				gap: 0.35rem;
			}
			.tel-link, .email-link {
				font-family: var(--font-ui);
				font-size: 0.77rem;
				color: var(--text-muted);
				text-decoration: none;
				flex: 1;
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				transition: color 0.15s;
			}
			.tel-link:hover, .email-link:hover {
				color: var(--red);
				text-decoration: none;
			}
			.copy-btn {
				flex-shrink: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 20px;
				height: 20px;
				border: 1px solid var(--border-light);
				border-radius: 3px;
				background: transparent;
				color: var(--text-faint);
				cursor: pointer;
				padding: 0;
				transition: color 0.15s, border-color 0.15s, background 0.15s;
			}
			.copy-btn:hover {
				color: var(--text-muted);
				border-color: var(--border);
				background: var(--bg-elevated);
			}
			.copy-btn.copied {
				color: #3a9e5a;
				border-color: color-mix(in srgb, #3a9e5a 40%, transparent);
				background: color-mix(in srgb, #3a9e5a 6%, transparent);
			}
			@media (prefers-color-scheme: dark) {
				.copy-btn.copied {
					color: #6fcf97;
					border-color: color-mix(in srgb, #6fcf97 40%, transparent);
					background: color-mix(in srgb, #6fcf97 8%, transparent);
				}
			}
			.ico { width: 10px; height: 10px; display: block; }
			.ico-check { display: none; }
			.copy-btn.copied .ico-copy { display: none; }
			.copy-btn.copied .ico-check { display: block; }
			.card-footer {
				padding: 0.75rem 1.1rem;
				border-top: 1px solid var(--border-light);
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: auto;
			}
			.web-link {
				font-family: var(--font-ui);
				font-size: 0.65rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				color: var(--text-muted);
				text-decoration: none;
				display: flex;
				align-items: center;
				gap: 0.3em;
				padding: 0.25em 0.6em;
				border: 1px solid var(--border-light);
				border-radius: 2px;
				background: var(--bg-elevated);
				transition: color 0.15s, border-color 0.15s;
			}
			.web-link svg { width: 10px; height: 10px; flex-shrink: 0; }
			.web-link:hover {
				color: var(--red);
				border-color: color-mix(in srgb, var(--red) 30%, transparent);
				text-decoration: none;
			}
			.empty-state {
				text-align: center;
				font-family: var(--font-body);
				font-style: italic;
				color: var(--text-muted);
				padding: 3rem 0;
				margin: 0;
			}
			@media (max-width: 900px) {
				.cards-grid { grid-template-columns: repeat(2, 1fr); }
			}
			@media (max-width: 600px) {
				main { padding: 2rem 1.25rem 3rem; }
				.page-header { padding: 2rem 1.25rem; }
				.cards-grid { grid-template-columns: 1fr; }
				.field { grid-template-columns: 36px 1fr; }
			}
		</style>
	</head>

	<body>
		<Header />

		<div class="page-header">
			<h1 class="page-title">Contacta a Roma</h1>
			<p class="page-subtitle">Directorio de la Curia Romana y organismos de la Santa Sede</p>
		</div>

		<main>
			<div class="controls">
				<input
					type="search"
					id="search"
					class="search-input"
					placeholder="Buscar organismo, correo, dirección…"
					autocomplete="off"
					spellcheck="false"
				/>
				<div class="cat-tabs" role="tablist" aria-label="Filtrar por categoría">
					{catTabs.map((tab, i) => (
						<button
							role="tab"
							class:list={['cat-tab', { active: i === 0 }]}
							data-cat={tab.id}
							aria-selected={i === 0 ? 'true' : 'false'}
						>
							{tab.label}
							<span class="tab-count">{tab.count}</span>
						</button>
					))}
				</div>
			</div>

			<div class="cards-grid" id="grid">
				{organismos.map(org => (
					<article
						class="card"
						data-cat={org.cat}
						data-search={normalize([
							org.nombre,
							org.sede ?? '',
							org.postal ?? '',
							...(org.emails?.map(em => em.e) ?? []),
							catLabels[org.cat] ?? '',
						].join(' '))}
					>
						<div class="card-top">
							<span class="badge">{catLabels[org.cat]}</span>
							<h2 class="card-nombre">{org.nombre}</h2>
						</div>

						<div class="card-body">
							{(org.sede || org.postal) && (
								<div class="field">
									<span class="field-label">Sede</span>
									<div class="field-val">
										{org.sede && <span>{org.sede}</span>}
										{org.postal && org.sede && org.sede !== org.postal && (
											<span class="postal">CP: {org.postal}</span>
										)}
										{!org.sede && org.postal && <span>{org.postal}</span>}
									</div>
								</div>
							)}

							{org.telefonos && org.telefonos.length > 0 && (
								<div class="field">
									<span class="field-label">Tel.</span>
									<div class="field-val">
										{org.telefonos.map(t => (
											<div class="copyrow">
												<a href={`tel:${t.n.replace(/\s/g, '')}`} class="tel-link">
													{t.n}{t.l && <span class="sub">({t.l})</span>}
												</a>
												<button class="copy-btn" data-copy={t.n} aria-label={`Copiar ${t.n}`} title="Copiar">
													<svg class="ico ico-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="5" width="9" height="10" rx="1.5"/><path d="M11 5V3a1 1 0 00-1-1H3a1 1 0 00-1 1v8a1 1 0 001 1h2"/></svg>
													<svg class="ico ico-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.5 3.5 6.5-8"/></svg>
												</button>
											</div>
										))}
									</div>
								</div>
							)}

							{org.fax && org.fax.length > 0 && (
								<div class="field">
									<span class="field-label">Fax</span>
									<div class="field-val">
										{org.fax.map(f => (
											<span class="fax-entry">{f.n}{f.l && <span class="sub">({f.l})</span>}</span>
										))}
									</div>
								</div>
							)}

							{org.emails && org.emails.length > 0 && (
								<div class="field">
									<span class="field-label">Email</span>
									<div class="field-val">
										{org.emails.map(em => (
											<div class="copyrow">
												<a href={`mailto:${em.e}`} class="email-link">
													{em.e}{em.l && <span class="sub">({em.l})</span>}
												</a>
												<button class="copy-btn" data-copy={em.e} aria-label={`Copiar ${em.e}`} title="Copiar">
													<svg class="ico ico-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="5" width="9" height="10" rx="1.5"/><path d="M11 5V3a1 1 0 00-1-1H3a1 1 0 00-1 1v8a1 1 0 001 1h2"/></svg>
													<svg class="ico ico-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.5 3.5 6.5-8"/></svg>
												</button>
											</div>
										))}
									</div>
								</div>
							)}
						</div>

						{org.webs && org.webs.length > 0 && (
							<div class="card-footer">
								{org.webs.map(w => (
									<a href={w} target="_blank" rel="noopener noreferrer" class="web-link">
										<svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5.5"/><path d="M7 1.5C5.5 3 4.5 5 4.5 7s1 4 2.5 5.5M7 1.5C8.5 3 9.5 5 9.5 7s-1 4-2.5 5.5M1.5 7h11"/></svg>
										{domain(w)}
									</a>
								))}
							</div>
						)}
					</article>
				))}
			</div>

			<p class="empty-state" id="empty" hidden>
				No se encontraron organismos con ese criterio.
			</p>
		</main>

		<Footer />

		<script is:inline>
			const searchInput = document.getElementById('search');
			const grid = document.getElementById('grid');
			const empty = document.getElementById('empty');
			const tabs = Array.from(document.querySelectorAll('.cat-tab'));
			const cards = Array.from(grid.querySelectorAll('.card'));

			let activeCat = 'todos';

			function norm(str) {
				return str.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
			}

			function filter() {
				const q = norm(searchInput.value);
				let visible = 0;
				cards.forEach(card => {
					const matchCat = activeCat === 'todos' || card.dataset.cat === activeCat;
					const matchQ = !q || card.dataset.search.includes(q);
					const show = matchCat && matchQ;
					card.style.display = show ? '' : 'none';
					if (show) visible++;
				});
				empty.hidden = visible > 0;
			}

			tabs.forEach(tab => {
				tab.addEventListener('click', () => {
					tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
					tab.classList.add('active');
					tab.setAttribute('aria-selected', 'true');
					activeCat = tab.dataset.cat;
					filter();
				});
			});

			searchInput.addEventListener('input', filter);

			document.querySelectorAll('.copy-btn').forEach(btn => {
				btn.addEventListener('click', async () => {
					const val = btn.dataset.copy;
					try {
						await navigator.clipboard.writeText(val);
					} catch {
						const ta = document.createElement('textarea');
						ta.value = val;
						ta.style.cssText = 'position:fixed;opacity:0';
						document.body.appendChild(ta);
						ta.select();
						document.execCommand('copy');
						document.body.removeChild(ta);
					}
					btn.classList.add('copied');
					setTimeout(() => btn.classList.remove('copied'), 2000);
				});
			});
		</script>
	</body>
</html>
