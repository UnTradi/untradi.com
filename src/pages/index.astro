---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = allPosts.find((p) => p.data.featured);
const recentPosts = allPosts.filter((p) => !p.data.featured);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.content-wrap {
				max-width: var(--max-wide);
				margin: 0 auto;
				padding: 0 2rem 5rem;
			}

			/* ── Featured ─────────────────────────────── */

			.featured-wrap {
				border-bottom: 1px solid var(--border);
				padding: 3rem 0;
			}

			.featured-card {
				display: grid;
				grid-template-columns: 1fr 340px;
				gap: 0;
				background: var(--bg-surface);
				border: 1px solid var(--border);
				text-decoration: none;
				transition: border-color 0.25s, box-shadow 0.25s;
				position: relative;
				overflow: hidden;
			}

			.featured-card:hover {
				border-color: color-mix(in srgb, var(--red) 30%, var(--border));
				box-shadow: 0 0 0 1px color-mix(in srgb, var(--red) 15%, transparent);
				text-decoration: none;
			}

			.featured-body {
				padding: 3rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 1rem;
				position: relative;
				z-index: 1;
			}

			.featured-eyebrow {
				font-family: var(--font-ui);
				font-size: 0.65rem;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--red);
				margin: 0;
			}

			.featured-card-title {
				font-family: var(--font-display);
				font-size: clamp(1.8rem, 3.5vw, 2.6rem);
				font-weight: 700;
				color: var(--text);
				margin: 0;
				line-height: 1.18;
				letter-spacing: -0.02em;
				transition: color 0.2s;
			}

			.featured-card:hover .featured-card-title {
				color: var(--red-light);
			}

			.featured-card-desc {
				font-family: var(--font-body);
				font-size: 1rem;
				font-style: italic;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.65;
			}

			.featured-card-meta {
				font-family: var(--font-ui);
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text-faint);
			}

			.featured-panel {
				background: var(--bg-elevated);
				border-left: 1px solid var(--border);
				display: flex;
				align-items: center;
				justify-content: center;
				position: relative;
				overflow: hidden;
			}

			.featured-panel-glyph {
				font-family: var(--font-display);
				font-size: 18rem;
				font-weight: 900;
				font-style: italic;
				color: var(--text);
				opacity: 0.03;
				line-height: 1;
				user-select: none;
				pointer-events: none;
				position: absolute;
			}

			.featured-panel-label {
				font-family: var(--font-ui);
				font-size: 0.65rem;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--text-faint);
				writing-mode: vertical-rl;
				text-orientation: mixed;
				transform: rotate(180deg);
			}

			/* ── Section divider ──────────────────────── */

			.section-divider {
				display: flex;
				align-items: center;
				gap: 1.5rem;
				padding: 2.5rem 0 2rem;
			}

			.section-divider-line {
				flex: 1;
				height: 1px;
				background: var(--border);
			}

			.section-divider-label {
				font-family: var(--font-ui);
				font-size: 0.65rem;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--text-faint);
				white-space: nowrap;
			}

			/* ── Posts list ───────────────────────────── */

			.posts-list {
				display: flex;
				flex-direction: column;
			}

			.post-row {
				display: grid;
				grid-template-columns: 140px 1fr;
				gap: 2.5rem;
				padding: 1.5rem 0;
				border-bottom: 1px solid var(--border);
				text-decoration: none;
				align-items: baseline;
				transition: box-shadow 0.2s;
			}

			.post-row:hover {
				text-decoration: none;
				box-shadow: -2px 0 0 var(--red);
			}

			.post-row:first-child {
				border-top: 1px solid var(--border);
			}

			.post-row-date {
				font-family: var(--font-ui);
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--text-faint);
				white-space: nowrap;
				padding-top: 0.2rem;
			}

			.post-row-title {
				font-family: var(--font-display);
				font-size: 1.2rem;
				font-weight: 700;
				color: var(--text);
				margin: 0 0 0.3rem;
				line-height: 1.25;
				letter-spacing: -0.01em;
				transition: color 0.2s;
			}

			.post-row:hover .post-row-title {
				color: var(--red);
			}

			.post-row-desc {
				font-family: var(--font-body);
				font-size: 0.9rem;
				font-style: italic;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.5;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* ── Responsive ───────────────────────────── */

			@media (max-width: 820px) {
				.featured-card {
					grid-template-columns: 1fr;
				}
				.featured-panel {
					display: none;
				}
				.featured-body {
					padding: 2rem;
				}
			}

			@media (max-width: 640px) {
				.post-row {
					grid-template-columns: 1fr;
					gap: 0.4rem;
				}
				.content-wrap {
					padding: 0 1.25rem 3rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main class="content-wrap">
			{featuredPost && (
				<div class="featured-wrap">
					<a href={`/blog/${featuredPost.id}/`} class="featured-card">
						<div class="featured-body">
							<p class="featured-eyebrow">Artículo destacado</p>
							<h2 class="featured-card-title">{featuredPost.data.title}</h2>
							<p class="featured-card-desc">{featuredPost.data.description}</p>
							<span class="featured-card-meta">
								<FormattedDate date={featuredPost.data.pubDate} />
							</span>
						</div>
						<div class="featured-panel" aria-hidden="true">
							<span class="featured-panel-glyph">T</span>
							<span class="featured-panel-label">Artículo destacado</span>
						</div>
					</a>
				</div>
			)}

			{recentPosts.length > 0 && (
				<section>
					<div class="section-divider" aria-hidden="true">
						<span class="section-divider-line"></span>
						<span class="section-divider-label">Últimos artículos</span>
						<span class="section-divider-line"></span>
					</div>

					<div class="posts-list">
						{recentPosts.map((post) => (
							<a href={`/blog/${post.id}/`} class="post-row">
								<span class="post-row-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<div>
									<h2 class="post-row-title">{post.data.title}</h2>
									<p class="post-row-desc">{post.data.description}</p>
								</div>
							</a>
						))}
					</div>
				</section>
			)}
		</main>

		<Footer />
	</body>
</html>
