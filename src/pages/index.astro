---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = allPosts.find((p) => p.data.featured);
const recentPosts = allPosts.filter((p) => !p.data.featured);
const totalPosts = allPosts.length;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.content-wrap {
				max-width: var(--max-wide);
				margin: 0 auto;
				padding: 0 2rem 5rem;
			}

			/* ── Stats strip ─────────────────────────── */

			.stats-strip {
				display: flex;
				align-items: center;
				gap: 3rem;
				padding: 1.5rem 0;
				border-bottom: 1px solid var(--border);
				animation: fadeIn 0.6s ease both;
			}

			.stat-item {
				display: flex;
				align-items: baseline;
				gap: 0.4em;
			}

			.stat-number {
				font-family: var(--font-display);
				font-size: 2rem;
				font-weight: 700;
				color: var(--red);
				line-height: 1;
				letter-spacing: -0.04em;
				display: inline-block;
			}

			.stat-label {
				font-family: var(--font-ui);
				font-size: 0.65rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text-faint);
			}

			.stats-divider {
				width: 1px;
				height: 24px;
				background: var(--border);
			}

			/* ── Featured ─────────────────────────────── */

			.featured-wrap {
				border-bottom: 1px solid var(--border);
				padding: 3rem 0;
			}

			.featured-label {
				font-family: var(--font-ui);
				font-size: 0.6rem;
				font-weight: 700;
				letter-spacing: 0.25em;
				text-transform: uppercase;
				color: var(--text-faint);
				margin: 0 0 1.25rem;
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.featured-label::after {
				content: '';
				flex: 1;
				height: 1px;
				background: var(--border);
			}

			.featured-card {
				display: grid;
				grid-template-columns: 1fr 300px;
				gap: 0;
				text-decoration: none;
				position: relative;
				overflow: hidden;
				border: 1px solid var(--border);
				transform-style: preserve-3d;
				will-change: transform;
				transition:
					border-color 0.35s,
					box-shadow 0.35s,
					transform 0.15s ease-out;
			}

			.featured-card:hover {
				border-color: color-mix(in srgb, var(--red) 40%, var(--border));
				box-shadow:
					0 0 0 1px color-mix(in srgb, var(--red) 15%, transparent),
					0 20px 60px color-mix(in srgb, var(--red) 10%, transparent),
					0 4px 16px color-mix(in srgb, var(--text) 8%, transparent);
				text-decoration: none;
			}

			.featured-card-shine {
				position: absolute;
				inset: 0;
				background: radial-gradient(
					600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
					color-mix(in srgb, var(--gold) 6%, transparent),
					transparent 40%
				);
				pointer-events: none;
				z-index: 2;
				opacity: 0;
				transition: opacity 0.3s;
			}

			.featured-card:hover .featured-card-shine {
				opacity: 1;
			}

			.featured-body {
				padding: 3rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 1rem;
				position: relative;
				z-index: 1;
				background: var(--bg-surface);
			}

			.featured-eyebrow {
				font-family: var(--font-ui);
				font-size: 0.65rem;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--gold);
				margin: 0;
				display: flex;
				align-items: center;
				gap: 0.5em;
			}

			.featured-eyebrow::before {
				content: '✦';
				font-size: 0.5em;
				color: var(--gold);
			}

			.featured-card-title {
				font-family: var(--font-display);
				font-size: clamp(1.8rem, 3.5vw, 2.6rem);
				font-weight: 700;
				color: var(--text);
				margin: 0;
				line-height: 1.18;
				letter-spacing: -0.02em;
				transition: color 0.25s;
			}

			.featured-card:hover .featured-card-title {
				color: var(--red);
			}

			.featured-card-desc {
				font-family: var(--font-body);
				font-size: 1rem;
				font-style: italic;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.65;
			}

			.featured-card-cta {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				font-family: var(--font-ui);
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--red);
				transition: gap 0.25s var(--ease-out-expo);
				width: fit-content;
			}

			.featured-card:hover .featured-card-cta {
				gap: 0.9em;
			}

			.featured-card-cta-arrow {
				font-size: 1rem;
				font-weight: 400;
				letter-spacing: 0;
				transition: transform 0.25s var(--ease-out-expo);
			}

			.featured-card:hover .featured-card-cta-arrow {
				transform: translateX(5px);
			}

			.featured-card-meta {
				font-family: var(--font-ui);
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text-faint);
			}

			.featured-panel {
				background: var(--bg-elevated);
				border-left: 1px solid var(--border);
				display: flex;
				align-items: center;
				justify-content: center;
				position: relative;
				overflow: hidden;
			}

			.featured-panel::before {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(135deg,
					color-mix(in srgb, var(--red) 5%, transparent),
					transparent 50%,
					color-mix(in srgb, var(--gold) 5%, transparent)
				);
			}

			.featured-panel-glyph {
				font-family: var(--font-display);
				font-size: 18rem;
				font-weight: 900;
				font-style: italic;
				color: var(--text);
				opacity: 0.04;
				line-height: 1;
				user-select: none;
				pointer-events: none;
				position: absolute;
				transition: opacity 0.4s, transform 0.4s ease;
			}

			.featured-card:hover .featured-panel-glyph {
				opacity: 0.08;
				transform: scale(1.06);
			}

			.featured-panel-cross {
				font-size: 2.5rem;
				color: var(--gold);
				opacity: 0.2;
				position: relative;
				z-index: 1;
				transition: opacity 0.4s, transform 0.5s var(--ease-out-expo);
			}

			.featured-card:hover .featured-panel-cross {
				opacity: 0.5;
				transform: scale(1.1) rotate(8deg);
			}

			/* ── Section divider ──────────────────────── */

			.section-divider {
				display: flex;
				align-items: center;
				gap: 1.25rem;
				padding: 2.5rem 0 2rem;
			}

			.section-divider-line {
				flex: 1;
				height: 1px;
				background: linear-gradient(to right, transparent, var(--border), transparent);
			}

			.section-divider-center {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.section-divider-label {
				font-family: var(--font-ui);
				font-size: 0.65rem;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--text-faint);
				white-space: nowrap;
			}

			.section-divider-ornament {
				color: var(--gold);
				font-size: 0.55rem;
				opacity: 0.6;
			}

			/* ── Posts list ───────────────────────────── */

			.posts-list {
				display: flex;
				flex-direction: column;
			}

			.post-row {
				display: grid;
				grid-template-columns: 140px 1fr auto;
				gap: 2rem;
				padding: 1.4rem 0.75rem 1.4rem 1rem;
				border-bottom: 1px solid var(--border);
				text-decoration: none;
				align-items: center;
				position: relative;
				transition:
					background 0.25s,
					padding-left 0.3s var(--ease-out-expo),
					transform 0.2s var(--ease-out-expo);
			}

			.post-row-indicator {
				position: absolute;
				left: 0;
				top: 15%;
				bottom: 15%;
				width: 3px;
				background: linear-gradient(to bottom, var(--red), var(--gold));
				border-radius: 0 2px 2px 0;
				transform: scaleY(0);
				transform-origin: center;
				transition: transform 0.35s var(--ease-out-expo);
			}

			.post-row:hover {
				text-decoration: none;
				background: color-mix(in srgb, var(--bg-surface) 60%, transparent);
				padding-left: 1.5rem;
			}

			.post-row:hover .post-row-indicator {
				transform: scaleY(1);
			}

			.post-row:first-child {
				border-top: 1px solid var(--border);
			}

			.post-row-date {
				font-family: var(--font-ui);
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--text-faint);
				white-space: nowrap;
				transition: color 0.2s;
				flex-shrink: 0;
			}

			.post-row:hover .post-row-date {
				color: var(--gold);
			}

			.post-row-title {
				font-family: var(--font-display);
				font-size: 1.2rem;
				font-weight: 700;
				color: var(--text);
				margin: 0 0 0.3rem;
				line-height: 1.25;
				letter-spacing: -0.01em;
				transition: color 0.2s;
			}

			.post-row:hover .post-row-title {
				color: var(--red);
			}

			.post-row-desc {
				font-family: var(--font-body);
				font-size: 0.9rem;
				font-style: italic;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.5;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.post-row-arrow {
				font-size: 1.1rem;
				color: var(--border);
				flex-shrink: 0;
				transition: color 0.2s, transform 0.3s var(--ease-out-expo);
				opacity: 0;
			}

			.post-row:hover .post-row-arrow {
				color: var(--red);
				transform: translateX(4px);
				opacity: 1;
			}

			/* ── Responsive ───────────────────────────── */

			@media (max-width: 820px) {
				.featured-card { grid-template-columns: 1fr; }
				.featured-panel { display: none; }
				.featured-body { padding: 2rem; }
				.stats-strip { gap: 1.5rem; }
			}

			@media (max-width: 640px) {
				.post-row { grid-template-columns: 1fr; gap: 0.4rem; }
				.post-row-date { font-size: 0.62rem; }
				.post-row-arrow { display: none; }
				.content-wrap { padding: 0 1.25rem 3rem; }
				.stats-strip { display: none; }
			}
		</style>
	</head>

	<body>
		<Header />

		<main class="content-wrap">

			<div class="stats-strip" aria-label="Estadísticas del sitio">
				<div class="stat-item">
					<span class="stat-number" data-count-to={totalPosts}>0</span>
					<span class="stat-label">artículos</span>
				</div>
				<span class="stats-divider" aria-hidden="true"></span>
				<div class="stat-item">
					<span class="stat-label">Tradición · Liturgia · Fe</span>
				</div>
			</div>

			{featuredPost && (
				<div class="featured-wrap reveal">
					<p class="featured-label" aria-hidden="true">Artículo destacado</p>
					<a href={`/blog/${featuredPost.id}/`} class="featured-card" id="featured-card">
						<div class="featured-card-shine" aria-hidden="true"></div>
						<div class="featured-body">
							<p class="featured-eyebrow">Artículo destacado</p>
							<h2 class="featured-card-title">{featuredPost.data.title}</h2>
							<p class="featured-card-desc">{featuredPost.data.description}</p>
							<span class="featured-card-cta">
								Leer artículo
								<span class="featured-card-cta-arrow">→</span>
							</span>
							<span class="featured-card-meta">
								<FormattedDate date={featuredPost.data.pubDate} />
							</span>
						</div>
						<div class="featured-panel" aria-hidden="true">
							<span class="featured-panel-glyph">T</span>
							<span class="featured-panel-cross">✠</span>
						</div>
					</a>
				</div>
			)}

			{recentPosts.length > 0 && (
				<section>
					<div class="section-divider reveal" aria-hidden="true">
						<span class="section-divider-line"></span>
						<span class="section-divider-center">
							<span class="section-divider-ornament">✦</span>
							<span class="section-divider-label">Últimos artículos</span>
							<span class="section-divider-ornament">✦</span>
						</span>
						<span class="section-divider-line"></span>
					</div>

					<div class="posts-list">
						{recentPosts.map((post, i) => (
							<a href={`/blog/${post.id}/`} class={`post-row reveal reveal-d${Math.min(i + 1, 10)}`}>
								<div class="post-row-indicator" aria-hidden="true"></div>
								<span class="post-row-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<div>
									<h2 class="post-row-title">{post.data.title}</h2>
									<p class="post-row-desc">{post.data.description}</p>
								</div>
								<span class="post-row-arrow" aria-hidden="true">→</span>
							</a>
						))}
					</div>
				</section>
			)}
		</main>

		<Footer />

		<script>
			function initHome() {
				/* ── Scroll reveal ────────────────── */
				const revealObserver = new IntersectionObserver(
					(entries) => entries.forEach((e) => {
						if (e.isIntersecting) {
							e.target.classList.add('is-visible');
							revealObserver.unobserve(e.target);
						}
					}),
					{ threshold: 0.07, rootMargin: '0px 0px -40px 0px' }
				);
				document.querySelectorAll('.reveal, .reveal-left').forEach((el) => {
					el.classList.remove('is-visible');
					revealObserver.observe(el);
				});

				/* ── Animated counter ─────────────── */
				const countEls = document.querySelectorAll<HTMLElement>('[data-count-to]');
				const counterObserver = new IntersectionObserver((entries) => {
					entries.forEach((e) => {
						if (!e.isIntersecting) return;
						const el = e.target as HTMLElement;
						const target = parseInt(el.dataset.countTo ?? '0', 10);
						const duration = 900;
						const start = performance.now();
						const tick = (now: number) => {
							const progress = Math.min((now - start) / duration, 1);
							const eased = 1 - Math.pow(1 - progress, 3);
							el.textContent = String(Math.round(eased * target));
							if (progress < 1) requestAnimationFrame(tick);
						};
						requestAnimationFrame(tick);
						counterObserver.unobserve(el);
					});
				}, { threshold: 0.5 });
				countEls.forEach((el) => {
					el.textContent = '0';
					counterObserver.observe(el);
				});

				/* ── Featured card 3D tilt ────────── */
				const card = document.getElementById('featured-card') as HTMLAnchorElement | null;
				const shine = card?.querySelector<HTMLElement>('.featured-card-shine');

				if (card) {
					let raf = 0;
					let targetX = 0, targetY = 0, currentX = 0, currentY = 0;

					card.addEventListener('mousemove', (e) => {
						const rect = card.getBoundingClientRect();
						const x = (e.clientX - rect.left) / rect.width;
						const y = (e.clientY - rect.top) / rect.height;
						targetX = (x - 0.5) * 7;
						targetY = -(y - 0.5) * 7;

						if (shine) {
							shine.style.setProperty('--mouse-x', `${x * 100}%`);
							shine.style.setProperty('--mouse-y', `${y * 100}%`);
						}

						cancelAnimationFrame(raf);
						const animate = () => {
							currentX += (targetX - currentX) * 0.12;
							currentY += (targetY - currentY) * 0.12;
							card.style.transform = `perspective(1200px) rotateY(${currentX}deg) rotateX(${currentY}deg)`;
							if (Math.abs(targetX - currentX) > 0.05 || Math.abs(targetY - currentY) > 0.05) {
								raf = requestAnimationFrame(animate);
							}
						};
						raf = requestAnimationFrame(animate);
					});

					card.addEventListener('mouseleave', () => {
						cancelAnimationFrame(raf);
						const reset = () => {
							currentX += (0 - currentX) * 0.1;
							currentY += (0 - currentY) * 0.1;
							card.style.transform = `perspective(1200px) rotateY(${currentX}deg) rotateX(${currentY}deg)`;
							if (Math.abs(currentX) > 0.05 || Math.abs(currentY) > 0.05) {
								raf = requestAnimationFrame(reset);
							} else {
								card.style.transform = '';
							}
						};
						raf = requestAnimationFrame(reset);
					});
				}

				/* ── Magnetic social links ─────────── */
				document.querySelectorAll<HTMLElement>('.social-link').forEach((link) => {
					link.addEventListener('mousemove', (e) => {
						const rect = link.getBoundingClientRect();
						const cx = rect.left + rect.width / 2;
						const cy = rect.top + rect.height / 2;
						const dx = (e.clientX - cx) * 0.35;
						const dy = (e.clientY - cy) * 0.35;
						link.style.transform = `translate(${dx}px, ${dy}px) scale(1.18)`;
						link.style.transition = 'transform 0.1s ease';
					});
					link.addEventListener('mouseleave', () => {
						link.style.transform = '';
						link.style.transition = 'transform 0.4s var(--ease-out-expo)';
					});
				});
			}

			// Se ejecuta en carga inicial y en cada navegación via View Transitions
			document.addEventListener('astro:page-load', initHome);
		</script>
	</body>
</html>
